# =============================================================================
# VIGÍA — Forensic Intentionality Analysis Engine
# SANS FIND EVIL Hackathon 2026
# Copyright (c) 2026 Anna Tchijova
#
# .env.example — Variables de entorno del sistema
# Copiar como .env y completar los valores antes de ejecutar.
# NUNCA subir .env a control de versiones (está en .gitignore).
# =============================================================================


# -----------------------------------------------------------------------------
# LLM BACKEND
# Opciones: anthropic | ollama
# Para hackathon/producción: anthropic
# Para uso offline/local:    ollama
# -----------------------------------------------------------------------------
VIGIA_LLM_BACKEND=anthropic

# API key de Anthropic (requerida si VIGIA_LLM_BACKEND=anthropic)
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (requerido si VIGIA_LLM_BACKEND=ollama)
VIGIA_OLLAMA_HOST=http://127.0.0.1:11434
VIGIA_OLLAMA_MODEL=llama3


# -----------------------------------------------------------------------------
# INTEGRIDAD HMAC — cadena de custodia Daubert
# VIGIA_HMAC_KEY:      clave hex de 32 bytes mínimo (generar con: openssl rand -hex 32)
# VIGIA_HMAC_KEY_FILE: alternativa — ruta a archivo con la clave (modo HSM/vault)
# Al menos una de las dos debe estar configurada en producción.
# -----------------------------------------------------------------------------
VIGIA_HMAC_KEY=
VIGIA_HMAC_KEY_FILE=


# -----------------------------------------------------------------------------
# AUTENTICACIÓN MCP
# Token de autenticación del servidor MCP.
# Generar con: openssl rand -hex 32
# -----------------------------------------------------------------------------
VIGIA_MCP_AUTH_TOKEN=

# Clave del operador humano para confirmación de acciones de alto riesgo
# Generar con: openssl rand -hex 16
VIGIA_HUMAN_OPERATOR_KEY=

# Secreto para validación de webhooks de alertas (HMAC-SHA256)
VIGIA_WEBHOOK_SECRET=
# Permitir webhooks sobre HTTP (false en producción — usar HTTPS siempre)
VIGIA_WEBHOOK_ALLOW_HTTP=false


# -----------------------------------------------------------------------------
# DIRECTORIOS DE EVIDENCIA Y LOGS
# -----------------------------------------------------------------------------
VIGIA_EVIDENCE_DIR=/var/lib/vigia/evidence
VIGIA_LOG_DIR=/var/log/vigia


# -----------------------------------------------------------------------------
# PIPELINE — umbrales y límites
# -----------------------------------------------------------------------------
# Umbral de confianza para decisiones automáticas (0.0–1.0)
VIGIA_AUTO_THRESHOLD=0.7

# Pasos máximos por investigación autónoma
VIGIA_MAX_STEPS=15

# Ventana de loop para detección de ciclos
VIGIA_LOOP_WINDOW=3

# Tamaño máximo de archivo a procesar (MB)
VIGIA_MAX_FILE_MB=500

# Rate limit global de herramientas MCP (llamadas por minuto)
VIGIA_RATE_LIMIT=10

# Profundidad máxima de búsqueda grep
VIGIA_GREP_DEPTH=5

# Umbral de entropía para detección de contenido cifrado/comprimido
VIGIA_ENTROPY_THRESHOLD=6.0


# -----------------------------------------------------------------------------
# MÓDULOS — activación selectiva
# -----------------------------------------------------------------------------
VIGIA_NLP_ENABLED=true
VIGIA_CAIE_ENABLED=true
VIGIA_LR_ENGINE_ENABLED=true
VIGIA_TRUST_FUSION_ENABLED=true
VIGIA_ENTANGLEMENT_ENABLED=true


# -----------------------------------------------------------------------------
# MODO STRICT — producción / uso judicial
# Activar todos antes de cualquier uso forense en entorno real.
# -----------------------------------------------------------------------------

# Bloquear si el modelo CLIP no tiene hash configurado (supply-chain)
VIGIA_STRICT_MODEL_CHECK=false

# Verificar hash del system prompt Peirce en cada arranque
VIGIA_STRICT_PROMPT=false

# Modo forense estricto (rechaza evidencia sin cadena de custodia completa)
VIGIA_FORENSIC_STRICT=false

# Emitir explicaciones detalladas en cada decisión del planner
VIGIA_EXPLAIN=false


# -----------------------------------------------------------------------------
# INTEGRIDAD DEL DICCIONARIO FONÉTICO
# VIGIA_PHONETIC_DICT: ruta alternativa al diccionario (override del bundled)
# VIGIA_PHONETIC_HASH: SHA-256 esperado del diccionario activo
# -----------------------------------------------------------------------------
VIGIA_PHONETIC_DICT=
VIGIA_PHONETIC_HASH=


# -----------------------------------------------------------------------------
# INTEGRIDAD DEL SYSTEM PROMPT PEIRCE
# VIGIA_SYSTEM_PROMPT_PATH: ruta al prompt (default: bundled)
# VIGIA_PROMPT_HASH:        SHA-256 esperado del prompt activo
# -----------------------------------------------------------------------------
VIGIA_SYSTEM_PROMPT_PATH=
VIGIA_PROMPT_HASH=


# -----------------------------------------------------------------------------
# INTEGRIDAD DEL MODELO CLIP (visión forense)
# VIGIA_CLIP_HASH_FILE:     JSON con mapa filename → sha256
# VIGIA_CLIP_HASH_VIT_B_32: hash SHA-256 del modelo ViT-B/32 (override directo)
# Obtener hash con: sha256sum ~/.cache/clip/ViT-B-32.pt
# -----------------------------------------------------------------------------
VIGIA_CLIP_HASH_FILE=
VIGIA_CLIP_HASH_VIT_B_32=


# -----------------------------------------------------------------------------
# SANDBOX — aislamiento de procesos
# -----------------------------------------------------------------------------
VIGIA_ENFORCE_POSIX_SANDBOX=false
VIGIA_SANDBOX_CPU_SEC=30
VIGIA_SANDBOX_MEMORY_MB=512

# UID al que bajar privilegios después de iniciar (Linux)
VIGIA_DROP_PRIVS_UID=

# Forzar comunicación exclusiva por stdio (sin sockets externos)
VIGIA_ENFORCE_STDIO=false

# Verificar que el proceso padre sea el servidor MCP autorizado
VIGIA_ENFORCE_PARENT=false

# Timeout para sandbox en Windows (segundos)
VIGIA_WINDOWS_TIMEOUT=5

# Activar eBPF para monitoreo de syscalls (requiere privilegios root + kernel 5.8+)
VIGIA_EBPF=false
