# =============================================================================
# VIGÍA — Forensic Intentionality Analysis Engine
# Copyright (c) 2026 Anna Tchijova
#
# .env.example — System environment variables
# Copy as .env and fill in values before running.
# NEVER commit .env to version control (it's in .gitignore).
#
# Every variable below is read somewhere in the live codebase (verified by
# grep against os.environ/os.getenv call sites, 2026-07-25) — this file does
# not document aspirational or planned config, only what actually gates
# behavior today. Two exceptions were intentionally REMOVED from a prior
# version of this file because they are confirmed no-ops (see SECURITY.md,
# "MCP Transport Security"): VIGIA_MCP_AUTH_TOKEN and VIGIA_ENFORCE_STDIO
# are no longer read anywhere in this codebase — an earlier revision of both
# this file and the code described VIGIA_MCP_AUTH_TOKEN as gating HTTP/SSE
# access, but it only ever checked for the token's *presence* at startup,
# never validated it against a request, because no HTTP/SSE serving path
# exists here. A documented-but-nonfunctional control is worse than none, so
# it was removed rather than left to mislead an operator. VIGÍA serves MCP
# over stdio only; stdio's security model is OS-level process isolation
# (only the parent process can read/write the server's stdin/stdout), which
# needs no token.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM BACKEND
# Options: anthropic | ollama
# For production: anthropic
# For offline/local use:    ollama
# -----------------------------------------------------------------------------
VIGIA_LLM_BACKEND=anthropic

# Anthropic API key (required if VIGIA_LLM_BACKEND=anthropic)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (required if VIGIA_LLM_BACKEND=ollama)
VIGIA_OLLAMA_HOST=http://127.0.0.1:11434
VIGIA_OLLAMA_MODEL=llama3

# Optional — alternate narrative-generation backend for VigiaPipeline's
# report writer (vigia/pipeline/pipeline.py, independent of
# VIGIA_LLM_BACKEND above, which governs MCP-mode reasoning). Only needed if
# you explicitly request the "gemini" narrative backend.
GEMINI_API_KEY=


# -----------------------------------------------------------------------------
# HMAC INTEGRITY — Daubert chain of custody
# VIGIA_HMAC_KEY:      hex key, 32 bytes minimum (generate: openssl rand -hex 32)
# VIGIA_HMAC_KEY_FILE: alternative — path to a file containing the key (HSM/vault mode)
# At least one of the two must be set in production.
#
# VIGIA_ENFORCE_HMAC_KEY=true: fail closed (abort) if neither key is set,
# instead of the default fail-open behavior (warn + continue with an
# ephemeral, never-recorded key — the security_audit.log HMAC chain then
# resets on every restart, so a tampered/truncated log becomes
# indistinguishable from a legitimate restart). Recommended for production.
# -----------------------------------------------------------------------------
VIGIA_HMAC_KEY=
VIGIA_HMAC_KEY_FILE=
VIGIA_ENFORCE_HMAC_KEY=false

# Optional — salt for PBKDF2-HMAC-SHA256 key derivation (100k iterations) in
# the resource-optimizer / release-bundle integrity path, so a raw
# environment dump does not directly reveal the signing key. Hex-encoded.
# Only used when both this and VIGIA_HMAC_KEY are set.
VIGIA_HMAC_SALT=


# -----------------------------------------------------------------------------
# KASSANDRA PROTOCOL — semantic tripwire (session-nonce-derived ghost_protocol)
# KASSANDRA_SALT: hex/random secret used to derive the session nonce and the
#   tripwire id unpredictably (generate: openssl rand -hex 32). Without it,
#   the tripwire falls back to a hardcoded, publicly-known salt — an
#   attacker who controls evidence content can precompute the tripwire id
#   offline and forge or evade KASSANDRA_TRIPWIRE_TRIGGERED events.
#   NOTE: no VIGIA_ prefix — this is intentional, matches the live code.
#
# VIGIA_ENFORCE_KASSANDRA_SALT=true: fail closed (abort startup) if
# KASSANDRA_SALT is unset, instead of the default fail-open (warn +
# continue with the predictable fallback salt). Recommended for production.
# -----------------------------------------------------------------------------
KASSANDRA_SALT=
VIGIA_ENFORCE_KASSANDRA_SALT=false

# Operator co-signing key for high-risk plan actions (human-in-the-loop
# confirmation). Minimum 32 characters. Generate: openssl rand -hex 32
# Required when VIGIA_FORENSIC_STRICT=true and a plan step needs co-signing.
VIGIA_HUMAN_OPERATOR_KEY=

# Secret for validating alert webhook payloads (HMAC-SHA256)
VIGIA_WEBHOOK_SECRET=
# Allow webhooks over plain HTTP (false in production — always use HTTPS)
VIGIA_WEBHOOK_ALLOW_HTTP=false


# -----------------------------------------------------------------------------
# EVIDENCE, LOG, AND STATE DIRECTORIES
# VIGIA_EVIDENCE_DIR: read-only forensic evidence root. NEVER written to.
# VIGIA_LOG_DIR:      where SecurityAudit writes security_audit.log.
# VIGIA_WORK_DIR:     private operational state for the MCP bridge — mounted
#                     filesystems, quarantine copies, honey tokens. Must be
#                     outside VIGIA_EVIDENCE_DIR. Default: a private mode-0700
#                     temp dir for the server's lifetime.
# VIGIA_EXECUTION_LOG_DIR: derived execution JSONL logs. Default:
#                     $VIGIA_WORK_DIR/logs, then an XDG-style user state dir.
# VIGIA_FORENSIC_DB_PATH:  durable SQLite state for ACP/temporal/entanglement
#                     modules. Default: $VIGIA_WORK_DIR/vigia_forensic.db.
# VIGIA_CHAIN_DB_PATH:     persistent sealed-bundle chain ledger. Default:
#                     $VIGIA_WORK_DIR/vigia_chain.db.
# None of the four below may point inside VIGIA_EVIDENCE_DIR.
# -----------------------------------------------------------------------------
VIGIA_EVIDENCE_DIR=/var/lib/vigia/evidence
VIGIA_LOG_DIR=/var/log/vigia
VIGIA_WORK_DIR=/var/lib/vigia/work
VIGIA_EXECUTION_LOG_DIR=/var/lib/vigia/work/logs
VIGIA_FORENSIC_DB_PATH=/var/lib/vigia/work/vigia_forensic.db
VIGIA_CHAIN_DB_PATH=/var/lib/vigia/work/vigia_chain.db

# Allowlisted base paths for memory-dump / registry-hive acquisition tools,
# os.pathsep-separated (":" on Linux/macOS, ";" on Windows). Lets VIGÍA run
# outside its default layout (/opt/vigia, SIFT, Kali, custom deployments).
# Falls back to /var/vigia/dumps:/tmp/vigia:/home/vigia/cases and
# equivalents if unset.
VIGIA_ALLOWED_DUMP_PATHS=
VIGIA_ALLOWED_REGISTRY_PATHS=


# -----------------------------------------------------------------------------
# PIPELINE — thresholds and limits
# -----------------------------------------------------------------------------
# Confidence threshold for automated decisions (0.0-1.0)
VIGIA_AUTO_THRESHOLD=0.7

# Maximum steps per autonomous investigation
VIGIA_MAX_STEPS=15

# Loop window for cycle detection
VIGIA_LOOP_WINDOW=3

# Maximum file size to process (MB)
VIGIA_MAX_FILE_MB=500

# Global rate limit for MCP tools (calls per minute)
VIGIA_RATE_LIMIT=10

# Maximum grep search depth
VIGIA_GREP_DEPTH=5

# Entropy threshold for encrypted/compressed content detection
VIGIA_ENTROPY_THRESHOLD=6.0

# Maximum nodes/edges in the abductive artifact graph (DoS guard). Range
# [1000, 1000000] enforced at import time — out-of-range values fall back to
# the safe default (MAX_NODES * 10 = 50000). MUST be set in the environment
# BEFORE the process imports vigia.abduction.vigia_artifact_graph — the
# value is cached as a module constant at import time, so setting it later
# via os.environ from within the same process has no effect.
VIGIA_MAX_EDGES=

# EBS hypothesis-resolution mode: motor | legacy. "motor" (default) derives
# the hypothesis from the canonical scorer, label-blind. "legacy" reproduces
# pre-B-163 behavior where the case's expected_verdict label leaks into the
# hypothesis — retained ONLY for reproducing/evaluating historical bundles,
# never as a default; any unrecognized value falls back to "motor".
VIGIA_EBS_RESOLVE=motor


# -----------------------------------------------------------------------------
# MODULES — selective activation
# -----------------------------------------------------------------------------
VIGIA_NLP_ENABLED=true
VIGIA_CAIE_ENABLED=true
VIGIA_TRUST_FUSION_ENABLED=true
VIGIA_ENTANGLEMENT_ENABLED=true

# Paired-bundle review tool (compare_paired_bundles, L-029 F2): deterministic
# cross-bundle sub-metrics; Thirdness synthesis is left to the calling
# analyst/LLM, outside the decision loop.
VIGIA_PAIRED_REVIEW_ENABLED=true

# Pericial (expert-report) PDF export for adversarial NLP findings.
VIGIA_PERICIAL_PDF_ENABLED=true
# Output directory for generated pericial PDFs. Default: current directory.
VIGIA_PERICIAL_PDF_DIR=.


# -----------------------------------------------------------------------------
# STRICT MODE — production / judicial use
# Enable all of these before any forensic use in a real environment.
# -----------------------------------------------------------------------------

# Block if the CLIP model has no configured hash (supply-chain integrity).
# NOTE: the code's own default when this var is UNSET is already "true"
# (vigia/forensics/vision_audit.py — "P1-7: safe default"). It is listed
# here, set to true, so this file matches that default explicitly rather
# than silently overriding it to permissive — a prior version of this file
# set it to false, which downgraded strictness the moment it was copied
# to .env, contradicting this section's own "enable before forensic use"
# intent.
VIGIA_STRICT_MODEL_CHECK=true

# Verify the Peirce system prompt's hash on every startup
VIGIA_STRICT_PROMPT=false

# Strict forensic mode (rejects evidence without complete chain of custody)
VIGIA_FORENSIC_STRICT=false

# Emit detailed explanations for every planner decision
VIGIA_EXPLAIN=false


# -----------------------------------------------------------------------------
# PHONETIC DICTIONARY INTEGRITY
# VIGIA_PHONETIC_DICT: alternate path to the dictionary (overrides bundled)
# VIGIA_PHONETIC_HASH: expected SHA-256 of the active dictionary
# -----------------------------------------------------------------------------
VIGIA_PHONETIC_DICT=
VIGIA_PHONETIC_HASH=


# -----------------------------------------------------------------------------
# PEIRCE SYSTEM PROMPT INTEGRITY
# VIGIA_SYSTEM_PROMPT_PATH: path to the prompt (default: bundled)
# VIGIA_PROMPT_HASH:        expected SHA-256 of the active prompt
# -----------------------------------------------------------------------------
VIGIA_SYSTEM_PROMPT_PATH=
VIGIA_PROMPT_HASH=


# -----------------------------------------------------------------------------
# CLIP MODEL INTEGRITY (forensic vision)
# VIGIA_CLIP_HASH_FILE:        JSON mapping filename -> sha256
# VIGIA_CLIP_HASH_VIT_B_32_PT: SHA-256 of the ViT-B/32 model (direct override)
#   General form: VIGIA_CLIP_HASH_<FILENAME>, filename uppercased with "-"
#   and "." replaced by "_" (e.g. ViT-B-32.pt -> VIGIA_CLIP_HASH_VIT_B_32_PT
#   — confirmed by executing _load_clip_model_hashes(); note the "_PT" from
#   the extension, easy to drop by hand and silently no-op as an override).
# Get the hash with: sha256sum ~/.cache/clip/ViT-B-32.pt
# -----------------------------------------------------------------------------
VIGIA_CLIP_HASH_FILE=
VIGIA_CLIP_HASH_VIT_B_32_PT=


# -----------------------------------------------------------------------------
# SANDBOX — process isolation
# -----------------------------------------------------------------------------
VIGIA_ENFORCE_POSIX_SANDBOX=false
VIGIA_SANDBOX_CPU_SEC=30
VIGIA_SANDBOX_MEMORY_MB=512

# UID to drop privileges to after startup (Linux)
VIGIA_DROP_PRIVS_UID=

# Block startup if the parent process is not in the allowed executable list
# (claude, node, python3, ollama, etc. — see SECURITY.md)
VIGIA_ENFORCE_PARENT=false

# Sandbox timeout on Windows (seconds)
VIGIA_WINDOWS_TIMEOUT=5

# Enable eBPF syscall monitoring (requires root privileges + kernel 5.8+)
VIGIA_EBPF=false


# -----------------------------------------------------------------------------
# HTTP GATEWAY (Mode 5 / OpenWebUI, experimental) — vigia_api.py
# This gateway has NO application-level authentication. Only change
# VIGIA_HOST off loopback if it sits behind an authenticated network
# boundary (reverse proxy, VPN, firewall) — never expose it directly.
# VIGIA_REPO: repo root override, only needed if running vigia_api.py
# outside its normal checkout layout.
# -----------------------------------------------------------------------------
VIGIA_HOST=127.0.0.1
VIGIA_PORT=8000
VIGIA_REPO=
